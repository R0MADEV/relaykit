{
  "name": "relaykit",
  "private": true,
  "version": "0.1.0-alpha.1",
  "description": "Headless messaging SDK for web applications and Electron",
  "type": "module",
  "workspaces": [
    "packages/*",
    "examples/*"
  ],
  "scripts": {
    "build": "tsc -b",
    "matrix:up": "sh infrastructure/matrix/up.sh",
    "check": "npm run typecheck && npm run build",
    "smoke:matrix": "node scripts/smoke-matrix.mjs",
    "smoke:relaykit": "node scripts/smoke-relaykit.mjs",
    "smoke:recovery": "node scripts/smoke-recovery.mjs",
    "smoke:verification": "node scripts/smoke-verification.mjs",
    "test:unit": "npm run build && node --test tests/*.test.mjs",
    "typecheck": "tsc -b --pretty false",
    "pack:check": "npm pack --dry-run -w @relaykit/core -w @relaykit/browser-storage -w @relaykit/in-memory -w @relaykit/matrix-js -w @relaykit/web",
    "release:check": "npm run check && npm run test:unit && npm run pack:check",
    "test:contract": "npm run build && RELAYKIT_CONTRACT_MATRIX=1 node --test --test-force-exit tests/adapter-contract.test.mjs",
    "smoke:group": "node scripts/smoke-group.mjs",
    "smoke:devices": "node scripts/smoke-devices.mjs",
    "smoke:outage": "node scripts/smoke-outage.mjs",
    "smoke:federation": "node scripts/smoke-federation.mjs",
    "federation:up": "sh infrastructure/matrix/federation/up.sh",
    "smoke:registration": "node scripts/smoke-registration.mjs",
    "smoke:chat": "node scripts/smoke-chat.mjs",
    "smoke:live": "node scripts/smoke-live.mjs",
    "smoke:qr": "node scripts/smoke-qr.mjs",
    "smoke:window": "node scripts/smoke-window.mjs",
    "smoke:revocation": "node scripts/smoke-revocation.mjs",
    "smoke:push": "node scripts/smoke-push.mjs",
    "smoke:user-verification": "node scripts/smoke-user-verification.mjs",
    "bench:local": "node scripts/bench-local.mjs",
    "bench:round-trips": "node scripts/bench-round-trips.mjs",
    "check:web-demo": "npm run build --workspace=@relaykit/example-web && electron scripts/check-web-demo.cjs --no-sandbox --js-flags=--expose-gc --enable-precise-memory-info",
    "bench:big-room": "node scripts/bench-big-room.mjs",
    "bench:memory": "node --expose-gc scripts/bench-memory.mjs"
  },
  "devDependencies": {
    "electron": "^44.3.0",
    "fake-indexeddb": "^6.2.5",
    "typescript": "^5.7.0"
  },
  "engines": {
    "node": ">=20"
  },
  "license": "Apache-2.0",
  "author": "Irontec"
}
